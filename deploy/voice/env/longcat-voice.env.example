# SwitchOS LongCat voice stack environment template
# Copy to /etc/switchos/longcat-voice.env on a persistent host and adjust values.

BIND_HOST=0.0.0.0
INTERNAL_SERVICE_TOKEN=switchos-internal-dev-token-change-before-production
DATABASE_URL=postgresql://ubuntu:ubuntu@127.0.0.1:5432/switchos
REDIS_URL=redis://127.0.0.1:6379

# TypeScript core
PORT=3005
LONGCAT_VOICE_GATEWAY_URL=http://127.0.0.1:8104
LONGCAT_SPEECH_SERVICE_URL=http://127.0.0.1:8105
LONGCAT_TELEPHONY_MODE=asterisk-audiosocket
LONGCAT_SPEECH_STT_ENGINE=faster-whisper
LONGCAT_SPEECH_TTS_ENGINE=piper
LONGCAT_SPEECH_STT_MODEL=tiny.en
LONGCAT_SPEECH_STT_DEVICE=cpu
LONGCAT_SPEECH_STT_COMPUTE_TYPE=int8
PIPER_BIN=/usr/local/bin/piper
PIPER_MODEL=/opt/piper/en_US-lessac-medium.onnx
LONGCAT_AUDIOSOCKET_ADDR=0.0.0.0:9104
LONGCAT_CORE_URL=http://127.0.0.1:3005
NOTIFICATION_DISPATCHER_URL=http://127.0.0.1:8099
LOCAL_COMMERCE_GATEWAY_URL=http://127.0.0.1:8114
RETAIL_FORECAST_SERVICE_URL=http://127.0.0.1:8115
SMS_PROVIDER_URL=http://127.0.0.1:8199
EMAIL_PROVIDER_URL=
PUSH_PROVIDER_URL=
VOICE_PROVIDER_URL=
SIMILARWEB_BENCHMARK_DOMAINS=doordash.com,ubereats.com,grubhub.com
DAPR_PUBSUB_NAME=switchos-pubsub
DAPR_LOCAL_COMMERCE_TOPIC=local-commerce-events
KAFKA_BROKERS=
KAFKA_LOCAL_COMMERCE_TOPIC=local-commerce-events
FLUVIO_KAFKA_BROKERS=
FLUVIO_LOCAL_COMMERCE_TOPIC=local-commerce-events
TEMPORAL_BRIDGE_URL=
TEMPORAL_TASK_QUEUE=local-commerce-actions

# Optional middleware endpoints for stage proof
PERMIFY_ENDPOINT=http://127.0.0.1:3476
DAPR_HTTP_PORT=3500
OPENSEARCH_URL=http://127.0.0.1:9200
FLUVIO_SERVICE_URL=http://127.0.0.1:50055
MOJALOOP_SERVICE_URL=http://127.0.0.1:8086
TIGERBEETLE_SERVICE_URL=http://127.0.0.1:8087
LAKEHOUSE_SERVICE_URL=http://127.0.0.1:8007
