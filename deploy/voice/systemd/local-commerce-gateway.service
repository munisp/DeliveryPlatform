[Unit]
Description=SwitchOS Local Commerce Gateway
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/switchos/services/go/local-commerce-gateway
EnvironmentFile=/etc/switchos/longcat-voice.env
ExecStart=/usr/bin/env go run .
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
