{
	admin off

	servers {
		trusted_proxies static private_ranges
		protocols h1 h2 h3
	}
}

(security_headers) {
		header {
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-site"
			X-Permitted-Cross-Domain-Policies "none"
			Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https: wss:"
			-Server
		}
	encode zstd gzip
}

{$SWITCHOS_PUBLIC_HOST:localhost} {
	import security_headers
	request_body {
		max_size 5MB
	}

	handle_path /healthz {
		respond 200
	}

	reverse_proxy apisix:9080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Port 443
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		health_uri /healthz
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 60s
			write_timeout 60s
		}
	}
}

{$SWITCHOS_AUTH_HOST:auth.localhost} {
	import security_headers
	request_body {
		max_size 1MB
	}

	reverse_proxy keycloak:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Port 443
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
