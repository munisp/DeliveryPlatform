{
  "policy": {
    "name": "switchos-operator-edge",
    "mode": "prevent-learn",
    "practices": {
      "webAttackMitigation": {
        "enabled": true,
        "minimumConfidence": "medium",
        "protections": [
          "sql-injection",
          "cross-site-scripting",
          "remote-code-execution",
          "path-traversal",
          "command-injection",
          "method-enforcement"
        ]
      },
      "apiProtection": {
        "enabled": true,
        "schemaValidation": true,
        "blockUnknownMethods": true
      },
      "rateLimiting": {
        "enabled": true,
        "burstProtection": true
      },
      "botProtection": {
        "enabled": true,
        "suspiciousAutomation": "prevent"
      }
    },
    "targets": [
      {
        "host": "localhost",
        "ports": [443],
        "paths": ["/", "/api/*", "/api/trpc/*"]
      },
      {
        "host": "switchos.localhost",
        "ports": [443],
        "paths": ["/", "/api/*", "/api/trpc/*"]
      },
      {
        "host": "auth.localhost",
        "ports": [443],
        "paths": ["/", "/api/*", "/api/trpc/*"]
      }
    ]
  }
}
