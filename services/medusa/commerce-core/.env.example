# Copy to .env and replace every value through an approved secret-management path.
MEDUSA_POSTGRES_DB=medusa
MEDUSA_POSTGRES_USER=medusa
MEDUSA_POSTGRES_PASSWORD=replace_with_secret
MEDUSA_POSTGRES_PORT=5432
MEDUSA_REDIS_PASSWORD=replace_with_secret
MEDUSA_REDIS_PORT=6379
MEDUSA_PORT=9000
MEDUSA_DATABASE_URL=postgres://medusa:replace_with_secret@postgres:5432/medusa
MEDUSA_REDIS_URL=redis://:replace_with_secret@redis:6379
MEDUSA_STORE_CORS=https://store.example.test
MEDUSA_ADMIN_CORS=https://admin.example.test
MEDUSA_AUTH_CORS=https://admin.example.test
MEDUSA_JWT_SECRET=replace_with_32_or_more_random_bytes
MEDUSA_COOKIE_SECRET=replace_with_32_or_more_random_bytes
DELIVERYPLATFORM_COMMERCE_EVENT_URL=https://delivery.example.test/api/internal/commerce/medusa-events
DELIVERYPLATFORM_MEDUSA_STORE_ID=replace_with_store_identifier
DELIVERYPLATFORM_MEDUSA_SIGNING_SECRET=replace_with_secret_reference_value
