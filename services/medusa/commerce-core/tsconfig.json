{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": ".medusa/server",
    "rootDir": "."
  },
  "include": ["medusa-config.ts", "src/**/*.ts"]
}
