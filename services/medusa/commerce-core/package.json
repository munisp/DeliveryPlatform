{
  "name": "deliveryplatform-medusa-commerce-core",
  "private": true,
  "version": "1.0.0",
  "description": "MIT-core Medusa commerce service with DeliveryPlatform fulfillment event forwarding.",
  "scripts": {
    "build": "medusa build",
    "develop": "medusa develop",
    "start": "medusa start",
    "start:server": "MEDUSA_WORKER_MODE=server MEDUSA_ADMIN_DISABLED=false medusa start",
    "start:worker": "MEDUSA_WORKER_MODE=worker MEDUSA_ADMIN_DISABLED=true medusa start",
    "start:worker-supervisor": "node --require ts-node/register/transpile-only src/standalone/medusa-worker-supervisor.ts",
    "start:inventory-dispatcher": "MEDUSA_PROCESS_ROLE=inventory-dispatcher node --require ts-node/register/transpile-only src/standalone/inventory-outbox-dispatcher.ts",
    "migrate": "medusa db:migrate"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.20.1",
    "@medusajs/medusa": "2.20.1",
    "pg": "8.16.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=22.12.0" }
}
