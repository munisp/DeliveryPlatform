# perf-harness environment (baseline measured at commit 604d431).
# Sourced by scripts/perf/boot-server.sh. DO NOT put real secrets here.
NODE_ENV=development
PORT=3005
BIND_HOST=127.0.0.1
PUBLIC_APP_ORIGIN=http://127.0.0.1:3005
ALLOWED_ORIGINS=http://127.0.0.1:3005
DATABASE_URL=postgresql://postgres@/deliveryplatform?host=/tmp/pgdata-perf
JWT_SECRET=perf-harness-jwt-secret-0123456789abcdef
SESSION_SECRET=perf-harness-session-secret-0123456789abcdef
INTERNAL_SERVICE_TOKEN=perf-internal-token-0123456789abcdef00
INTERNAL_TOKEN=perf-internal-token-0123456789abcdef00
BOOTSTRAP_OPERATOR_EMAIL=admin@switchos.local
BOOTSTRAP_OPERATOR_NAME=SwitchOSOperatorAdmin
BOOTSTRAP_OPERATOR_PASSWORD=ChangeMe123!
BOOTSTRAP_OPERATOR_ROLE=admin
# OPA: bench.mjs spawns a stub OPA here so gated procedures make a real HTTP call.
OPA_ENDPOINT=http://127.0.0.1:8190
OPA_AUTH_TOKEN=perf-opa-token
LAKEHOUSE_SERVICE_URL=http://127.0.0.1:8007
NOTIFICATION_DISPATCHER_URL=http://127.0.0.1:8099
WORK_RECORD_SIGNER_URL=http://127.0.0.1:8109
WORK_RECORD_SIGNER_TOKEN=perf-internal-token-0123456789abcdef00
WORK_RECORD_SIGNER_SEED=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Intentionally UNSET: MARKET_ECONOMICS_URL -> defaults to dead 127.0.0.1:8110
# so the fail-open benchmark (economics.generateMarketReport) measures the
# dependency-DOWN path.
SERVICE_VERSION=perf-baseline-604d431
