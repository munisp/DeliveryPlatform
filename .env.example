COMPLIANCE_MAX_ELIGIBILITY_DAYS=30
COMPLIANCE_PROVIDER_TIMEOUT_SECONDS=8
COMPLIANCE_OPERATOR_SUBJECT_KEY=lagos-private-beta
COMPLIANCE_PROVIDER_NAME=REPLACE_WITH_APPROVED_VERIFIER_IDENTIFIER
