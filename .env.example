PAYMENT_VERIFY_URL_TEMPLATE=https://REPLACE_WITH_PROVIDER_API/transaction/verify/{reference}
PAYMENT_TRANSFER_VERIFY_URL_TEMPLATE=https://REPLACE_WITH_PROVIDER_API/transfer/verify/{reference}
