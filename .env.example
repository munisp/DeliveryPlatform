# ---------------------------------------------------------------------------
APISIX_ADMIN_URL=http://127.0.0.1:9180
APISIX_CONTROL_URL=http://127.0.0.1:8006
APISIX_ADMIN_KEY=REPLACE_WITH_APISIX_ADMIN_KEY
OPA_ENDPOINT=http://127.0.0.1:8181
OPA_AUTH_TOKEN=REPLACE_WITH_OPA_AUTH_TOKEN
