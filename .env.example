OPENSEARCH_USERNAME=REPLACE_WITH_OPENSEARCH_USERNAME
OPENSEARCH_PASSWORD=REPLACE_WITH_OPENSEARCH_PASSWORD
OPENSEARCH_OPERATIONAL_EVENTS_INDEX=operational-events
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=journeys
TEMPORAL_BRIDGE_URL=http://127.0.0.1:8282
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=deliveryplatform
KAFKA_OPERATIONAL_EVENTS_TOPIC=operational-events
KAFKA_FUNDS_TOPIC=funds
KAFKA_INVENTORY_TOPIC=inventory
