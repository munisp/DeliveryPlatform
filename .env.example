DAPR_HTTP_PORT=3500
DAPR_PUBSUB_NAME=switchos-pubsub
DAPR_OPERATIONAL_EVENTS_TOPIC=operational-events
DAPR_FUNDS_TOPIC=funds
DAPR_INVENTORY_TOPIC=inventory
DAPR_LOCAL_COMMERCE_TOPIC=local-commerce
FLUVIO_FUNDS_TOPIC=funds
FLUVIO_INVENTORY_TOPIC=inventory
FLUVIO_LOCAL_COMMERCE_TOPIC=local-commerce
FLUVIO_KAFKA_BROKERS=127.0.0.1:9092
FUNDS_OUTBOX_DESTINATIONS=dapr
FUNDS_OUTBOX_WORKER_ID=local-outbox-1
POLICY_CACHE_TTL_SECONDS=300
DB_MAX_OPEN_CONNS=16
DB_MAX_IDLE_CONNS=4
DATABASE_POOL_MAX_SIZE=4
RUST_LOG=info
BIND_ADDR=127.0.0.1:8080

# ---------------------------------------------------------------------------
# Object storage (lakehouse / media backups)
# ---------------------------------------------------------------------------
S3_ENDPOINT=https://REPLACE_WITH_S3_ENDPOINT
S3_REGION=REPLACE_WITH_S3_REGION
S3_BUCKET=REPLACE_WITH_S3_BUCKET
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_SESSION_TOKEN=
AWS_REGION=REPLACE_WITH_AWS_REGION
AWS_DEFAULT_REGION=REPLACE_WITH_AWS_REGION

# ---------------------------------------------------------------------------
# AI / voice (Longcat)
# ---------------------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=20000
OLLAMA_PRIMARY_TIMEOUT_MS=15000
OLLAMA_FALLBACK_TIMEOUT_MS=30000
OLLAMA_CACHE_TTL_MS=60000
LONGCAT_TELEPHONY_MODE=websocket
LONGCAT_CORE_URL=http://127.0.0.1:8103
LONGCAT_AUDIOSOCKET_ADDR=127.0.0.1:9092
LONGCAT_VOICE_WEBHOOK_SECRET=REPLACE_WITH_VOICE_WEBHOOK_SECRET
LONGCAT_MEMORY_CACHE_TTL_SECONDS=300
LONGCAT_SPEECH_STT_ENGINE=faster-whisper
LONGCAT_SPEECH_TTS_ENGINE=piper
LONGCAT_SPEECH_STT_MODEL=
LONGCAT_SPEECH_STT_DEVICE=cpu
LONGCAT_SPEECH_STT_COMPUTE_TYPE=int8
LONGCAT_SPEECH_STREAM_TIMEOUT_SECONDS=30
FASTER_WHISPER_MODEL=small
WHISPER_CPP_BIN=
WHISPER_MODEL=
PIPER_BIN=
PIPER_MODEL=
TLS_CERT=
TLS_KEY=
TLS_CERT_FILE=
TLS_KEY_FILE=

