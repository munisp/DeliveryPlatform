# DeliveryPlatform environment template.
#
# Copy to .env and fill in real values for local development. Every value in
# this file is a placeholder or a safe loopback default — NEVER commit real
# secrets. Production values are owned by the secret manager (see
# deploy/kubernetes/*/runtime-secrets.template.yaml).

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
BIND_HOST=0.0.0.0
PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000
API_BODY_LIMIT=1mb
HTTP_MAX_SOCKETS=256
REQUEST_TIMEOUT_MS=30000
CACHE_CONTROL_INDEX_HTML=no-cache
CSP_CONNECT_SRC='self'
SERVICE_VERSION=dev

DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@127.0.0.1:5432/deliveryplatform
DATABASE_SSL_CA=
DATABASE_TLS_CERT_EXPIRES_AT=
DATABASE_TLS_SKIP_VERIFY=false
TEST_DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@127.0.0.1:5432/deliveryplatform_test

REDIS_URL=redis://127.0.0.1:6379
REDIS_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Authentication / OIDC / sessions
# ---------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
SESSION_SECRET=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
SESSION_ISSUER=deliveryplatform
SESSION_AUDIENCE=deliveryplatform-app
OAUTH_SERVER_URL=
OIDC_ISSUER_URL=
OIDC_DISCOVERY_URL=
OIDC_LOGOUT_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_SCOPE=openid profile email
OIDC_REDIRECT_PATH=/api/oauth/callback
OIDC_POST_LOGOUT_PATH=/
ENABLE_EXTERNAL_OIDC=false
OWNER_OPEN_ID=
REQUIRE_MFA_FOR_PRIVILEGED_ACTIONS=true
VITE_APP_ID=REPLACE_WITH_OAUTH_APP_ID

# First-run operator bootstrap (local development only)
BOOTSTRAP_OPERATOR_EMAIL=operator@example.com
BOOTSTRAP_OPERATOR_NAME=Local Operator
BOOTSTRAP_OPERATOR_PASSWORD=REPLACE_WITH_STRONG_BOOTSTRAP_PASSWORD
BOOTSTRAP_OPERATOR_ROLE=admin
BOOTSTRAP_TENANT_ID=1

# Account lifecycle flows
LIFECYCLE_INVITATION_TTL_MINUTES=10080
LIFECYCLE_PASSWORD_RESET_TTL_MINUTES=60
LIFECYCLE_VERIFICATION_TTL_MINUTES=1440

# ---------------------------------------------------------------------------
# Internal service-to-service credential (shared by all in-cluster services)
# ---------------------------------------------------------------------------
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
INTERNAL_TOKEN=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET

# ---------------------------------------------------------------------------
# Service URLs (loopback defaults match the in-code development defaults)
# ---------------------------------------------------------------------------
MOJALOOP_SERVICE_URL=http://127.0.0.1:8086
MOJALOOP_SERVICE_MODE=ledger
MOJALOOP_SWITCH_URL=http://127.0.0.1:4001
MOJALOOP_PARTICIPANT_ID=REPLACE_WITH_DFSP_PARTICIPANT_ID
MOJALOOP_DATABASE_POOL_MAX=8
TIGERBEETLE_SERVICE_URL=http://127.0.0.1:8087
TIGERBEETLE_ADDRESSES=127.0.0.1:3000
TIGERBEETLE_CLUSTER_ID=0
TIGERBEETLE_ACCOUNT_MAP_JSON=REPLACE_WITH_ACCOUNT_MAP_JSON
TIGERBEETLE_FAULT_PROXY_ADDRESSES=
TIGERBEETLE_FAULT_PROXY_API_URL=
TIGERBEETLE_FAULT_PROXY_DIRECT_ADDRESSES=
LAKEHOUSE_SERVICE_URL=http://127.0.0.1:8007
DISPATCH_OPTIMIZER_URL=http://127.0.0.1:8090
LONGCAT_VOICE_GATEWAY_URL=http://127.0.0.1:8104
LONGCAT_SPEECH_SERVICE_URL=http://127.0.0.1:8105
VERIFICATION_INTELLIGENCE_URL=http://127.0.0.1:8106
VERIFICATION_INTELLIGENCE_TOKEN=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
SAFETY_ENGINE_URL=http://127.0.0.1:8107
SAFETY_ENGINE_TOKEN=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
INCENTIVES_WORKER_URL=http://127.0.0.1:8108
INCENTIVES_WORKER_TOKEN=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
WORK_RECORD_SIGNER_URL=http://127.0.0.1:8109
WORK_RECORD_SIGNER_TOKEN=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
# 64-hex-character Ed25519 signing seed owned by the work-record-signer service
WORK_RECORD_SIGNER_SEED=REPLACE_WITH_64_HEX_CHARACTER_SIGNING_SEED
MARKET_ECONOMICS_URL=http://127.0.0.1:8110
MARKET_ECONOMICS_TOKEN=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
VERTICAL_PROVISIONING_URL=http://127.0.0.1:8112
