PROCUREMENT_PLANNER_SERVICE_URL=http://127.0.0.1:8116
INVENTORY_CONTROL_SERVICE_URL=http://127.0.0.1:8117
COMPLIANCE_REVIEW_SERVICE_URL=http://127.0.0.1:8125
NOTIFICATION_DISPATCHER_URL=http://127.0.0.1:8099
FLUVIO_SERVICE_URL=127.0.0.1:50055
FINANCIAL_SIMULATION_MODE=disabled
FINANCIAL_SIMULATION_EXECUTOR_URL=
FINANCIAL_SIMULATION_EXECUTOR_TOKEN=
PLAYWRIGHT_EXECUTOR_URL=
PLAYWRIGHT_EXECUTOR_TOKEN=

# ---------------------------------------------------------------------------
