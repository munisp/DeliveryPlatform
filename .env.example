# ---------------------------------------------------------------------------
# Ride matching / local commerce tuning
# ---------------------------------------------------------------------------
MATCH_AVERAGE_SPEED_MPS=12
MATCH_CANDIDATE_LIMIT=12
MATCH_H3_RESOLUTION=9
MATCH_MIN_LOCATION_INTEGRITY=0.5
MATCH_OFFER_TTL_SECONDS=20
MATCH_OFFER_WAVE_SIZE=4
MATCH_RADIUS_METERS=4000
MATCH_REAPER_INTERVAL_SECONDS=5
MATCH_REQUIRE_DEVICE_INTEGRITY=false
LOCAL_COMMERCE_ENABLE_ASYNC_ENRICHMENT=false
LOCAL_COMMERCE_ENABLE_TRACING=true
LOCAL_COMMERCE_PLAN_CACHE_TTL_MS=30000
LOCAL_COMMERCE_TRACE_SAMPLE_RATE=0.1
LOCAL_COMMERCE_WORKSPACE_CACHE_TTL_MS=30000

